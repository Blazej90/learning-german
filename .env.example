# Konfiguracja Firebase — skopiuj do `.env.local` i wypełnij wartościami
# z konsoli: Project settings → Your apps → SDK setup and configuration.
#
# Te klucze są publiczne z natury (trafiają do bundle'a przeglądarki).
# Bezpieczeństwo danych opiera się na regułach z `firestore.rules`, nie na
# ukrywaniu tych wartości.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcjonalne — SDK działa bez nich, dopisz jeśli konsola je poda.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
